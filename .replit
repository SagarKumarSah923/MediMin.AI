modules = ["nodejs-24", "java-graalvm22.3", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

deployment.postBuild = { args = ["mvn", "-f", "services/medimin-spring/pom.xml", "clean", "package", "-DskipTests"], env = { "CI" = "true" } }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
